# Copie para .streamlit/secrets.toml (NÃO versionado) ou cole em Settings > Secrets no Streamlit Cloud.

[login]
# Gere o bloco com:  python gerar_senha.py
usuario = "mindsight"
senha_hash = ""

[dados]
# Repositório PRIVADO onde a coleta grava dados/*.csv
repo = "Data-Ops-Mindsight/dashboard-status-integracao-sankhya"
branch = "main"
# Fine-grained token: acesso só a esse repositório, permissão Contents: Read-only
token = ""

[sheets]
# Aba "Correções aplicadas" -- lê a planilha que
# automacao/aplicador/relatorio_sheets.py publica (repositório
# triagem_integracao_sankhya). Conteúdo INTEIRO do JSON de uma conta de
# serviço do Google Cloud com a Google Sheets API habilitada e acesso de
# leitura na planilha (mesma credencial que publica lá, ou uma cópia só
# com escopo de leitura).
credentials_json = ""
